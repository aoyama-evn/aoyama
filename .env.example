# ---- Ung dung ----
NODE_ENV=development
PORT=3001
API_PREFIX=api
APP_TIMEZONE=Asia/Tokyo
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ---- CSDL (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=aoyama
DB_PASSWORD=aoyama
DB_NAME=aoyama_service
DB_LOGGING=false

# ---- JWT ----
JWT_SECRET=doi-chuoi-nay-trong-moi-truong-that
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=doi-chuoi-refresh-nay-trong-moi-truong-that
JWT_REFRESH_EXPIRES_IN=30d

# ---- OTP (FR-AUTH-03, BR-02) ----
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Dat lich (BR-04..BR-08) ----
BOOKING_CANCEL_CUTOFF_HOURS=2
BOOKING_RESCHEDULE_CUTOFF_HOURS=2
BOOKING_MAX_ADVANCE_DAYS=60
BOOKING_REMINDER_HOURS_BEFORE=12
BOOKING_NO_SHOW_AFTER_HOURS=24

# ---- Luu tru tep ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_URL=http://localhost:3001/files

# ---- Dich vu AI (AI-01..AI-05) ----
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=10000

# ---- SMS / Email (OQ-06) ----
SMS_DRIVER=console
SMS_API_KEY=
SMS_SENDER=AOYAMA
MAIL_DRIVER=console
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@aoyama-service.jp
